{% extends 'base.html.twig' %}

{% block title %}TV Remote{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
{% endblock %}

{% block body %}
    <div class="container">
        <div class="row text-center justify-content-center">
            <div class="col-4">
                <h1>TV Remote</h1>

                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }}">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                <form method="post" class="d-grid gap-2">
                    <button class="btn btn-primary" name="button" value="on">On</button>
                    <button class="btn btn-primary" name="button" value="off">Off</button>
                    <button class="btn btn-primary" name="button" value="volume-up">Volume Up</button>
                    <button class="btn btn-primary" name="button" value="volume-down">Volume Down</button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
